{
  "name": "flowgt-recorder",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform screen recorder (screen + camera PiP + mic/system audio) built on Tauri 2 and ffmpeg. ~400 MB per hour HEVC.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run --coverage",
    "tauri": "tauri",
    "core:test": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "integration": "bash scripts/integration.sh",
    "bench": "bash scripts/bench.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "@tauri-apps/plugin-os": "^2.2.0",
    "@tauri-apps/plugin-store": "^2.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.7",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^26.0.0",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.5",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.1.1"
  }
}
